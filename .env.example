# SQL Server "MKEsindo" (ERP existing)
# NOTE: DB_SERVER/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD below are no longer
# read by src/lib/db.ts — getPool() now resolves live connection credentials
# from the Postgres perusahaan_koneksi table instead (see
# docs/superpowers/specs/2026-07-30-perusahaan-db-koneksi-design.md).
# Kept only for one-off scripts, historical reference, and as the source
# values originally seeded into Postgres. Only DB_ENCRYPT and
# DB_TRUST_SERVER_CERTIFICATE below are still read, and only as connection
# options (not credentials).
DB_SERVER=
DB_PORT=1433
DB_NAME=MKEsindo
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Auth.js (NextAuth v5)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL "directory" DB — Akun & Perusahaan (bridges MSSQL per company)
DIRECTORY_DB_HOST=
DIRECTORY_DB_PORT=5432
DIRECTORY_DB_NAME=pmp_directory
DIRECTORY_DB_USER=
DIRECTORY_DB_PASSWORD=
DIRECTORY_DB_SSL=false

# PT Prima Maesa Putra (Es Balok) MSSQL — not yet wired into any query code,
# stored here only so migrate-directory-db.ts can seed perusahaan_koneksi.
PMPUTRA_DB_HOST=
PMPUTRA_DB_PORT=1433
PMPUTRA_DB_USER=
PMPUTRA_DB_PASSWORD=
PMPUTRA_DB_NAME_UTAMA=FINAC_ES_PO
PMPUTRA_DB_NAME_LOGISTIK=FINAC_LOGISTIC_PO
